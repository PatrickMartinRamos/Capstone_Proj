    - target: {fileID: 8483318047551778772, guid: d1a76f4de2d0eb7479a35f2447f454bb, type: 3}
      propertyPath: m_text
      value: "<size=100><b>Region 1: Squaring the Binomial</b></size>\n\n<align=center>Oh
        no! The cannon needs an <b>STB Neutralizing Shell (SNS)</b> to lessen the
        bomb's impact! \n\nBy following the <b>\"Squaring the Binomial\"</b> We can
        open the case containing the SNS Shell!\n\nPlease Help us Dear Savior!</align>\n\n\n\n\n\n<i><size=0.8em><align=center>Touch
        Screen to Close</align></size></i>"
      objectReference: {fileID: 0}
    - target: {fileID: 8483318047551778772, guid: d1a76f4de2d0eb7479a35f2447f454bb, type: 3}
      propertyPath: m_fontSize
      value: 54.5
      objectReference: {fileID: 0}
