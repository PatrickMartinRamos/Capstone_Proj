      propertyPath: m_AnchoredPosition.x
      value: 347
      objectReference: {fileID: 0}
    - target: {fileID: 9136652380534691151, guid: d1a76f4de2d0eb7479a35f2447f454bb, type: 3}
      propertyPath: m_text
      value: '<align=center><size=80> <b>How To Play:</b></size></align>



        <b>1.
        Press the bomb</b> you want to neutralize to open the case containing the
        neutralizing cannon shell.'
      objectReference: {fileID: 0}
